# Copy to .env on the deployment host. Never commit real credentials.
EMBEDDING_DEVICE=cpu
EMBEDDING_MODEL=BAAI/bge-large-zh
EMBEDDING_REVISION=b5d9f5c027e87b6f0b6fa4b614f8f9cdc45ce0e8

# LLM backend: deepseek (hosted API) or ollama (self-hosted)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:32b
OLLAMA_API_KEY=
OLLAMA_THINK=false
OLLAMA_NUM_THREADS=2
OLLAMA_CONTEXT_LENGTH=4096

PUBMED_API_KEY=
LLM_TIMEOUT=120
# 800-1200 is a reasonable starting range; raise it for longer answers.
MAX_TOKENS=1200
CPU_THREADS=2
MAX_CONCURRENT=2

# Per-IP quota shared by both roles and by the JSON and streaming endpoints.
ASK_LIMIT=10/minute;100/day
# memory:// is only for single-process local runs. Docker Compose overrides this with Redis.
RATE_STORAGE_URI=memory://
# 0 when Gunicorn is exposed directly; Compose sets 1 because the app sits behind Caddy.
PROXY_HOPS=0
HEARTBEAT_SECONDS=10

# Public hostname for Caddy's automatic HTTPS, e.g. 203-0-113-10.sslip.io for Elastic IP 203.0.113.10
DOMAIN=203-0-113-10.sslip.io
